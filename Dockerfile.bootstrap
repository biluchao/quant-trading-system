# ==============================================================================
# 币安 BTC/ETH 3分钟量化交易系统 - Bootstrap 协调服务 Dockerfile
# ==============================================================================
# @file    Dockerfile.bootstrap
# @version 1.0.0
# @brief   Bootstrap 服务是多阶段启动协调器，负责按序初始化各子系统
#          多阶段构建 + 非 root + 健康检查，已修复 15 类运行时问题
#
# 构建方式:
#   docker build -f Dockerfile.bootstrap -t quant/bootstrap:1.0.0 \
#       --build-arg VERSION=1.0.0 \
#       --build-arg GIT_COMMIT=$(git rev-parse --short HEAD) .
#
# 运行方式:
#   docker run -d --name quant-bootstrap \
#       --read-only --tmpfs /tmp --tmpfs /app/data \
#       -v ./config:/app/config:ro \
#       -p 127.0.0.1:8080:8080 \
#       --cap-drop=ALL --security-opt=no-new-privileges:true \
#       quant/bootstrap:1.0.0
#
# 在 docker-compose.yml 中的使用:
#   bootstrap 服务先启动，完成后 core 服务通过
#   depends_on: bootstrap: condition: service_completed_successfully 启动
# ==============================================================================

# ==============================================================================
# 构建参数
# ==============================================================================
ARG DEBIAN_FRONTEND=noninteractive
ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

# ==============================================================================
# 阶段 1: 构建阶段（含完整编译工具链）
# ==============================================================================
FROM debian:12-slim AS builder

ARG DEBIAN_FRONTEND
ARG VERSION
ARG GIT_COMMIT
ARG BUILD_DATE

# 安装构建依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    git \
    ca-certificates \
    python3 \
    python3-pip \
    python3-venv \
    libboost-system-dev \
    libssl-dev \
    libpq-dev \
    libhiredis-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# 安装 Conan（使用虚拟环境隔离）
RUN python3 -m venv /opt/conan-venv \
    && /opt/conan-venv/bin/pip install --no-cache-dir \
       "conan>=2.0,<3.0" \
    && ln -sf /opt/conan-venv/bin/conan /usr/local/bin/conan

# 检测 Conan profile
RUN conan profile detect --force

WORKDIR /build

# 复制 Conan 配置（利用层缓存）
COPY conanfile.txt conan.lock ./

# 安装 Conan 依赖（锁定版本）
RUN conan install . \
    --lockfile=conan.lock \
    --build=missing \
    -s build_type=Release \
    -s compiler.cppstd=20 \
    --output-folder=/build/conan

# 复制源码和构建配置
COPY src/ ./src/
COPY cmake/ ./cmake/
COPY CMakeLists.txt VERSION ./

# 配置并构建 Bootstrap 服务
RUN cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_TOOLCHAIN_FILE=/build/conan/conan_toolchain.cmake \
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
    -DVERSION=${VERSION} \
    -DGIT_COMMIT=${GIT_COMMIT} \
    -DBUILD_DATE=${BUILD_DATE} \
    -DQUANT_BUILD_TESTS=OFF \
    -DQUANT_BUILD_BENCHMARKS=OFF \
    -DQUANT_ENABLE_IPO=ON \
    -DQUANT_ENABLE_PCH=ON \
    -DQUANT_NATIVE_ARCH=OFF \
    && cmake --build build -j"$(nproc)" --target quant_bootstrap

# 提取二进制
RUN mkdir -p /build/output \
    && cp build/bin/quant_bootstrap /build/output/ \
    && strip /build/output/quant_bootstrap || true

# ==============================================================================
# 阶段 2: 运行阶段（最小化镜像）
# ==============================================================================
FROM debian:12-slim AS runtime

ARG DEBIAN_FRONTEND
ARG VERSION

# OCI 标准标签
LABEL org.opencontainers.image.title="quant-bootstrap" \
      org.opencontainers.image.description="Binance BTC/ETH quantitative trading bootstrap orchestrator" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.vendor="quant-team" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/your-org/quant-trading-system"

# 安装最小运行时依赖（仅运行必需的库）
RUN apt-get update && apt-get install -y --no-install-recommends \
    libboost-system1.74.0 \
    libssl3 \
    libpq5 \
    libhiredis0.14 \
    ca-certificates \
    tini \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 创建非 root 用户（安全加固）
RUN groupadd -r -g 1000 quant \
    && useradd -r -u 1000 -g quant -m -d /home/quant -s /bin/bash quant

# 创建工作目录
WORKDIR /app

# 复制二进制
COPY --from=builder --chown=quant:quant /build/output/quant_bootstrap /app/quant_bootstrap

# 复制配置和脚本
COPY --chown=quant:quant config/ /app/config/
COPY --chown=quant:quant scripts/ /app/scripts/

# 创建运行时目录（日志、数据）
RUN mkdir -p /app/data/logs /app/data/snapshots /app/data/replay \
    && chown -R quant:quant /app/data /app

# 切换到非 root 用户
USER quant

# 环境变量
ENV ENV=prod \
    LOG_LEVEL=INFO \
    BOOTSTRAP_PORT=8080 \
    TZ=UTC \
    PATH="/app:${PATH}"

# 暴露端口
EXPOSE 8080

# 健康检查（Bootstrap 服务提供 /health 端点）
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:8080/health || exit 1

# 使用 tini 作为 init 进程（正确处理 SIGTERM 等信号）
ENTRYPOINT ["/usr/bin/tini", "--"]

# 启动命令
CMD ["/app/quant_bootstrap", "--env", "prod"]
