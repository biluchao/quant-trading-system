DEBUGPY_WAIT_FOR_CLIENT=false

# 启用 gdbserver（C++ 调试）
# 类型: bool
ENABLE_GDBSERVER=false

# gdbserver 端口
# 类型: int
GDBSERVER_PORT=2345

# 是否启用 SQL 日志（打印所有查询）
# 类型: bool
SQL_ECHO=false

# 是否跳过数据库迁移（开发时快速重启）
# 类型: bool
SKIP_MIGRATIONS=false

# 是否启用内存分析
# 类型: bool
MEMORY_PROFILING=false

# ==============================================================================
# 首次开发环境检查清单
# ==============================================================================
#
# [ ] 1. cp .env.dev.example .env.dev（若已有 .env.dev 跳过）
# [ ] 2. 从 https://testnet.binancefuture.com 申请测试网 API 密钥
# [ ] 3. 填入 BINANCE_API_KEY 和 BINANCE_API_SECRET（测试网）
# [ ] 4. 确认 ENV=dev
# [ ] 5. 确认 DEBUG=true
# [ ] 6. 确认 BINANCE_TESTNET=true
# [ ] 7. 确认 EXECUTION_MODE=VIRTUAL
# [ ] 8. 确认 ALLOW_LIVE_TRADING=false
# [ ] 9. 确认 DB_NAME=quant_dev（独立于生产）
# [ ] 10. 确认 DB_SSL=false, REDIS_SSL=false
# [ ] 11. 确认 ENABLE_HTTPS=false
# [ ] 12. 确认 RATE_LIMIT_ENABLED=false
# [ ] 13. 确认 IP_WHITELIST_ENABLED=false
# [ ] 14. 确认 AI_AUTO_ADJUST=false
# [ ] 15. 确认 AUTO_HEALING_ENABLED=false
# [ ] 16. 确认所有告警通知渠道为空
# [ ] 17. 生成 JWT_SECRET: openssl rand -hex 32（或用默认值）
# [ ] 18. 启动: docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d
# [ ] 19. 验证: curl http://localhost:8000/health
# [ ] 20. 访问前端: http://localhost:5173
#
# ==============================================================================
