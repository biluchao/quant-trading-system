# ==============================================================================

# Prometheus
# 类型: bool
PROMETHEUS_ENABLED=false

# 类型: int
PROMETHEUS_PORT=9090

# 监控指标采样间隔（开发环境较长，减少日志）
# 类型: int
METRICS_INTERVAL=30

# 指标保留天数
# 类型: int
METRICS_RETENTION_DAYS=1

# Grafana
# 类型: bool
GRAFANA_ENABLED=false

# 类型: int
GRAFANA_PORT=3001

# Grafana 管理员密码（开发环境）
# 类型: string (secret)
GRAFANA_ADMIN_PASSWORD=admin

# 告警阈值（开发环境不触发）
# 类型: float
ALERT_CPU_THRESHOLD=0.99
ALERT_MEMORY_THRESHOLD=0.99
ALERT_DISK_THRESHOLD=0.99
ALERT_LATENCY_P99_MS=10000
ALERT_ERROR_RATE=0.99

# 告警渠道（开发环境静默）
# 类型: list
ALERT_CHANNELS=

# SLO（开发环境不评估）
# 类型: float
SLO_AVAILABILITY=0.0
SLO_LATENCY_P99_MS=0
SLO_ERROR_RATE=0.0

# ==============================================================================
# 【13】通知配置（开发环境全部禁用）
# ==============================================================================

# Telegram
# 类型: bool
TELEGRAM_ENABLED=false

# 类型: string (secret)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 邮件
# 类型: bool
EMAIL_ENABLED=false

# 类型: string
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Webhook
# 类型: bool
WEBHOOK_ENABLED=false

# 类型: string (url)
WEBHOOK_URL=

# ==============================================================================
# 【14】后端服务（开发环境本地绑定）
# ==============================================================================

# 后端端口
# 类型: int
BACKEND_PORT=8000

# 后端绑定地址（开发环境绑 0.0.0.0 便于从宿主机访问）
# 类型: string
BACKEND_HOST=0.0.0.0

# Bootstrap 端口
# 类型: int
BOOTSTRAP_PORT=8080

# CORS 允许来源（开发环境允许本地前端）
# 类型: list
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# 是否允许携带凭证
# 类型: bool
CORS_ALLOW_CREDENTIALS=true

# CORS 预检缓存时间
# 类型: int
CORS_MAX_AGE=3600

# JWT 密钥（开发环境默认值，长度 >= 32）
# 类型: string (secret)
# 生成: openssl rand -hex 32
JWT_SECRET=dev_jwt_secret_0123456789abcdef0123456789abcdef

# JWT 过期时间（开发环境延长，避免频繁登录）
# 类型: int
JWT_EXPIRE_SECONDS=604800

# 是否启用 JWT 刷新
# 类型: bool
JWT_REFRESH_ENABLED=true

# ==============================================================================
# 【15】HTTPS 与安全（开发环境全部放宽）
# ==============================================================================

# 是否启用 HTTPS（开发环境关闭）
# 类型: bool
ENABLE_HTTPS=false

# SSL 证书路径（不使用）
# 类型: string (path)
SSL_CERT_PATH=
SSL_KEY_PATH=

# HSTS（开发环境禁用）
# 类型: int
HSTS_MAX_AGE=0

# API 限流（开发环境禁用，便于频繁测试）
# 类型: bool
RATE_LIMIT_ENABLED=false

# 类型: int
RATE_LIMIT_PER_IP=10000
RATE_LIMIT_PER_USER=10000
RATE_LIMIT_BURST=1000

# IP 白名单（开发环境禁用）
# 类型: bool
IP_WHITELIST_ENABLED=false

# 类型: list
IP_WHITELIST=

# API 鉴权
# 类型: bool
AUTH_ENABLED=true

# 鉴权方式
# 类型: enum (jwt|api_key|oauth2)
AUTH_METHOD=jwt

