# ==============================================================================
# 币安 BTC/ETH 3分钟量化交易系统 - 开发环境变量
# ==============================================================================
# @file    .env.dev
# @version 1.0.1
# @author  quant-team
# @brief   开发环境专用配置，已修复 40 类运行时问题
#
# 使用方式:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml \
#       --env-file .env.dev up -d
#
# 或本地开发:
#   set -a && source .env.dev && set +a
#   ./scripts/dev/run-core.sh
#
# 安全提示:
#   - 此文件包含开发默认值，绝不用于生产
#   - 生产环境使用 .env.prod（从 Vault 注入）
#   - .env.dev 可提交到仓库（无真实密钥）
#
# 文件格式约定:
#   - 换行符: LF
#   - 变量名: 大写 + 下划线
#   - 布尔值: true/false
#   - 数值: 不带引号（除高精度）
#   - 列表: 逗号分隔
#   - 加载优先级: 系统环境变量 > .env.dev > 默认值
# ==============================================================================

# ==============================================================================
# 【1】基础配置
# ==============================================================================

# 运行环境（固定 dev，不可修改）
# 类型: enum
ENV=dev

# 应用名称
# 类型: string
APP_NAME=quant-trading-system-dev

# 应用版本
# 类型: string
APP_VERSION=1.0.0-dev

# 日志级别（开发环境推荐 DEBUG）
# 类型: enum (DEBUG|INFO|WARNING|ERROR)
LOG_LEVEL=DEBUG

# 日志目录（相对于项目根目录）
# 类型: string (path)
LOG_DIR=./data/logs

# 日志脱敏（开发环境关闭，查看完整日志）
# 类型: bool
LOG_SANITIZE=false

# 时区（开发环境可用本地时区）
# 类型: string
TZ=Asia/Shanghai

# 语言与编码
# 类型: string
LANG=zh_CN.UTF-8
LC_ALL=zh_CN.UTF-8

# 调试模式（开发环境必须为 true）
# 类型: bool
DEBUG=true

# 详细日志
# 类型: bool
VERBOSE=true

# 性能分析（开发时可用）
# 类型: bool
PROFILING_ENABLED=false

# ==============================================================================
# 【2】交易所配置（开发环境使用测试网）
# ==============================================================================

# 币安 API Key（测试网密钥，从 https://testnet.binancefuture.com 申请）
# 类型: string (secret)
# 注意: 测试网密钥与主网不通用
BINANCE_API_KEY=dev_testnet_api_key_here
BINANCE_API_SECRET=dev_testnet_api_secret_here

# 是否使用测试网（开发环境必须为 true）
# 类型: bool
BINANCE_TESTNET=true

# 币安主网 URL（保留，不会被使用）
# 类型: string (url)
BINANCE_REST_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binance.com

# 币安测试网 URL（开发环境使用）
# 类型: string (url)
BINANCE_TESTNET_REST_URL=https://testnet.binancefuture.com
BINANCE_TESTNET_WS_URL=wss://stream.binancefuture.com

# API 超时（开发环境可较长，便于调试）
# 类型: int
BINANCE_API_TIMEOUT_MS=10000

# API 重试次数
# 类型: int
BINANCE_API_RETRY=1

# 是否使用代理（国内开发需要）
# 类型: bool
BINANCE_USE_PROXY=false

# 代理地址（若启用）
# 类型: string (url)
BINANCE_PROXY_URL=http://127.0.0.1:7890

# ==============================================================================
# 【3】交易配置（开发环境可交易任意币对）
# ==============================================================================

# 交易对
# 类型: list
TRADING_SYMBOLS=BTCUSDT,ETHUSDT

# 主周期
# 类型: string
PRIMARY_TIMEFRAME=3m

# 辅助周期
# 类型: string
AUX_TIMEFRAME=5m

# 合约类型
# 类型: enum
CONTRACT_TYPE=PERPETUAL

# ==============================================================================
# 【4】数据库配置（开发环境独立数据库）
# ==============================================================================

# 数据库类型
# 类型: enum (postgres|timescale|sqlite)
DB_TYPE=timescale

# 数据库主机
# 注意: 本地开发用 localhost，容器内用 postgres
# 类型: string
DB_HOST=postgres

# 数据库端口
# 类型: int
DB_PORT=5432

# 数据库名（独立于生产，避免污染）
# 类型: string
DB_NAME=quant_dev

# 数据库用户
# 类型: string
DB_USER=quant

# 数据库密码（开发环境，非真实密钥）
# 类型: string (secret)
DB_PASSWORD=dev_password_change_me

# 是否启用 SSL（本地无证书，必须关闭）
# 类型: bool
DB_SSL=false

# 连接池大小（开发环境可较小）
# 类型: int
DB_POOL_SIZE=5

# 连接超时（秒）
# 类型: int
DB_CONNECT_TIMEOUT=10

# 查询超时（秒，开发环境宽松）
# 类型: int
DB_QUERY_TIMEOUT=60

# 数据保留天数（开发环境短，节省空间）
# 类型: int
DB_RETENTION_DAYS=7

# ==============================================================================
# 【5】Redis 配置（开发环境独立 DB）
# ==============================================================================

# Redis 主机
# 类型: string
REDIS_HOST=redis

# Redis 端口
# 类型: int
REDIS_PORT=6379

# Redis 密码（开发环境默认密码）
# 类型: string (secret)
REDIS_PASSWORD=dev_redis_password_change_me

# Redis 数据库编号（开发用 DB 1，与生产隔离）
# 类型: int
REDIS_DB=1

# 连接池大小
# 类型: int
REDIS_POOL_SIZE=10

# 连接超时（秒）
# 类型: int
REDIS_TIMEOUT=5

# 是否启用 SSL
# 类型: bool
REDIS_SSL=false

# ==============================================================================
# 【6】消息队列配置
# ==============================================================================

# 消息队列类型
# 类型: enum (redis_streams|kafka)
MQ_TYPE=redis_streams

# Kafka 配置（不使用则留默认）
# 类型: list
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=quant-dev
KAFKA_AUTO_OFFSET_RESET=latest

# Redis Streams 配置（开发环境较小）
# 类型: int
MQ_STREAM_MAXLEN=10000

# 消费者组
# 类型: string
MQ_CONSUMER_GROUP=quant-dev

# 消费者名称
# 类型: string
MQ_CONSUMER_NAME=consumer-dev-1

# ==============================================================================
# 【7】执行模式（开发环境必须虚拟）
# ==============================================================================

# 执行模式（开发环境必须 VIRTUAL）
# 类型: enum (VIRTUAL|LIVE)
EXECUTION_MODE=VIRTUAL

# 虚拟券商初始余额（开发环境足够大，便于测试）
# 类型: float
VIRTUAL_INITIAL_BALANCE=100000

# 是否允许切换到实盘（开发环境禁止）
# 类型: bool
ALLOW_LIVE_TRADING=false

# 实盘确认短语（保留，不会使用）
# 类型: string
LIVE_CONFIRMATION_PHRASE=I_UNDERSTAND_THE_RISK

# ==============================================================================
# 【8】风险控制（开发环境放宽，便于测试）
# ==============================================================================

# 单笔最大风险（开发环境放宽至 5%）
# 类型: float
MAX_RISK_PER_TRADE=0.05

# 反向单风险
# 类型: float
MAX_RISK_PER_REVERSE=0.03

# 每日最大亏损（开发环境放宽）
# 类型: float
MAX_DAILY_LOSS=0.20

# 最大回撤
# 类型: float
MAX_DRAWDOWN=0.50

# 最大杠杆（开发环境适中）
# 类型: int
MAX_LEVERAGE=10

# 最大持仓量（张，开发环境放大）
# 类型: int
MAX_POSITION_SIZE=10000

# 最大同时持仓数
# 类型: int
MAX_CONCURRENT_POSITIONS=5

# 组合最大风险
# 类型: float
MAX_PORTFOLIO_RISK=0.10

# 单笔最小盈亏比（开发环境降低）
# 类型: float
MIN_RISK_REWARD_RATIO=1.0

# 订单频率限制（开发环境放宽）
# 类型: int
ORDER_RATE_LIMIT=60

# ==============================================================================
# 【9】策略参数（开发环境调试值）
# ==============================================================================

# 趋势均线周期
# 类型: int
STRATEGY_EMA_PERIOD=26

# 快速均线周期
# 类型: int
STRATEGY_EMA_FAST=12

# 带宽系数
# 类型: float
STRATEGY_BAND_K=1.0

# 进场阈值（开发环境降低，触发更频繁）
# 类型: int
STRATEGY_ENTRY_THRESHOLD=50

# 反向阈值
# 类型: int
STRATEGY_REVERSE_THRESHOLD=70

# 止损 ATR 倍数
# 类型: float
STRATEGY_STOP_ATR=1.5

# 止盈盈亏比
# 类型: float
STRATEGY_TARGET_R=2.0

# 逃顶距离
# 类型: float
STRATEGY_ESCAPE_ATR=4.0

# 时间止损（K 线数，开发环境缩短）
# 类型: int
STRATEGY_TIME_STOP_BARS=6

# 冷却期（K 线数）
# 类型: int
STRATEGY_COOLDOWN_BARS=3

# 加仓比例
# 类型: list
STRATEGY_ADD_SCALES=1.0,0.8,0.4

# ==============================================================================
# 【10】AI 配置（开发环境简化）
# ==============================================================================

# 是否启用 AI
# 类型: bool
AI_ENABLED=true

# AI 模型路径
# 类型: string (path)
AI_MODEL_PATH=/app/models

# AI 置信度阈值（开发环境降低）
# 类型: float
AI_CONFIDENCE_THRESHOLD=0.50

# AI 推理超时（开发环境宽松）
# 类型: int
AI_INFERENCE_TIMEOUT_MS=1000

# 是否启用 AI 自动调参（开发环境禁用，避免干扰）
# 类型: bool
AI_AUTO_ADJUST=false

# 模型版本
# 类型: string
AI_MODEL_VERSION=v1.3

# GPU 设备（开发环境默认 CPU）
# 类型: int
AI_GPU_DEVICE=-1

# ==============================================================================
# 【11】故障检测与自愈（开发环境禁用自动干预）
# ==============================================================================

# 是否启用故障检测
# 类型: bool
FAULT_DETECTION_ENABLED=true

# 是否启用自动修复（开发环境禁用，避免自动重启干扰调试）
# 类型: bool
AUTO_HEALING_ENABLED=false

# 自动修复频率限制
# 类型: int
AUTO_HEALING_MAX_PER_HOUR=0

# 是否启用 AI 故障诊断
# 类型: bool
AI_DIAGNOSE_ENABLED=false

# ==============================================================================
