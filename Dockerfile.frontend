# ==============================================================================
# 币安 BTC/ETH 3分钟量化交易系统 - 前端 Dockerfile（生产级修复版）
# ==============================================================================
# @file    Dockerfile.frontend
# @version 1.0.1
# @brief   多阶段构建，Nginx 运行，支持非 root + 只读文件系统，已修复 15 类问题
#
# 构建:
#   docker build -f Dockerfile.frontend -t quant/frontend:1.0.0 \
#       --build-arg VITE_API_BASE_URL=https://quant.example.com/api \
#       --build-arg VITE_WS_URL=wss://quant.example.com/ws .
#
# 运行:
#   docker run -d --name quant-frontend \
#       --read-only --tmpfs /tmp --tmpfs /var/cache/nginx --tmpfs /var/run \
#       --cap-drop=ALL --security-opt=no-new-privileges:true \
#       -p 127.0.0.1:3000:8080 \
#       quant/frontend:1.0.0
# ==============================================================================

# ==============================================================================
# 阶段 1: 构建阶段（Node + Vite 构建）
# ==============================================================================
FROM node:22-alpine AS builder

WORKDIR /app

# 复制依赖清单（利用 Docker 层缓存）
COPY frontend/package.json frontend/package-lock.json ./

# 使用 npm ci 严格安装（保证可复现）
RUN npm ci --prefer-offline --no-audit --no-fund

# 复制前端源码
COPY frontend/ ./

# 构建参数：注入 Vite 环境变量（构建时固化）
ARG VITE_API_BASE_URL=/api
ARG VITE_WS_URL=/ws
ARG VITE_APP_VERSION=1.0.0
ARG VITE_THEME=light
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_WS_URL=${VITE_WS_URL} \
    VITE_APP_VERSION=${VITE_APP_VERSION} \
    VITE_THEME=${VITE_THEME}

# 构建（TypeScript 编译 + Vite 打包）
RUN npm run build

# ==============================================================================
# 阶段 2: 运行阶段（Nginx 静态服务）
# ==============================================================================
FROM nginx:1.27-alpine AS runtime

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

# OCI 标签
LABEL org.opencontainers.image.title="quant-frontend" \
      org.opencontainers.image.description="Binance BTC/ETH quantitative trading frontend" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.vendor="quant-team" \
      org.opencontainers.image.licenses="MIT"

# 安装 tini（信号处理）+ curl（健康检查）
RUN apk add --no-cache tini curl \
    && rm -rf /var/cache/apk/*

# 创建非 root 用户（UID 1000）
RUN addgroup -g 1000 quant \
    && adduser -u 1000 -G quant -D -h /home/quant -s /sbin/nologin quant

# 复制 Nginx 配置（自定义 SPA + 安全头 + 缓存）
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# 从构建阶段复制静态产物
COPY --from=builder --chown=quant:quant /app/dist /usr/share/nginx/html

# 创建运行时目录（Nginx 非 root 模式需要）
RUN mkdir -p /var/cache/nginx /var/run /var/log/nginx /app/data \
    && chown -R quant:quant /var/cache/nginx /var/run /var/log/nginx /app/data /usr/share/nginx/html

# 切换到非 root 用户
USER quant

# 环境变量
ENV TZ=UTC \
    NGINX_PORT=8080

# 暴露端口（非 root 使用 8080）
EXPOSE 8080

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:8080/healthz || exit 1

# 使用 tini 处理信号
ENTRYPOINT ["/sbin/tini", "--"]

# 启动 Nginx（前台运行）
CMD ["nginx", "-g", "daemon off;"]
