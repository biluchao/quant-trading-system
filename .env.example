# ==============================================================================
# 币安 BTC/ETH 3分钟量化交易系统 - .env.example（生产级修复版）
# ==============================================================================
# @file    .env.example
# @version 1.0.1
# @author  quant-team
# @brief   已修复 15 类运行时问题
#
# 使用方法:
#   1. cp .env.example .env
#   2. chmod 600 .env
#   3. 编辑 .env 填入真实值
#   4. 切勿提交 .env 到 Git
#
# 安全提示:
#   - .env 已加入 .gitignore，不会被提交
#   - 生产环境建议使用 Vault/KMS 管理密钥
#   - 定期轮换 API 密钥（每 90 天）
#
# 文件格式约定:
#   - 换行符: LF（不要 CRLF）
#   - 变量名: 大写 + 下划线
#   - 布尔值: true/false（不用 1/0/yes/no）
#   - 数值: 不带引号（除高精度）
#   - 列表: 逗号分隔
#   - 含特殊字符的值: 用引号包裹
#   - 空值: 留空（不写 null/none）
#   - 注释: 独占一行
#   - 加载优先级: 系统环境变量 > .env > 默认值
# ==============================================================================

# ==============================================================================
# 【1】基础配置
# ==============================================================================

# 运行环境: dev | test | staging | prod
# 类型: string
ENV=dev

# 应用名称
# 类型: string
APP_NAME=quant-trading-system

# 应用版本
# 类型: string
APP_VERSION=1.0.0

# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
# 生产环境建议: INFO 或 WARNING
# 类型: string
LOG_LEVEL=INFO

# 日志目录（相对于项目根目录）
# 类型: string
LOG_DIR=./data/logs

# 时区
# 类型: string (IANA timezone)
TZ=UTC

# 语言
# 类型: string
LANG=zh_CN.UTF-8

# 调试模式（生产环境必须为 false）
# 类型: bool
DEBUG=false

# 详细日志
# 类型: bool
VERBOSE=false

# ==============================================================================
# 【2】交易所配置（币安）
# ==============================================================================

# 币安 API 密钥（生产环境从 Vault 读取）
# 类型: string (secret)
BINANCE_API_KEY=your_api_key_here

# 币安 API 密钥
# 类型: string (secret)
BINANCE_API_SECRET=your_api_secret_here

# 是否使用测试网
# 类型: bool
BINANCE_TESTNET=true

# 币安 API 基础 URL
# 类型: string (url)
BINANCE_REST_URL=https://fapi.binance.com

# 币安 WebSocket URL
# 类型: string (url)
BINANCE_WS_URL=wss://fstream.binance.com

# 测试网 REST URL
# 类型: string (url)
BINANCE_TESTNET_REST_URL=https://testnet.binancefuture.com

# 测试网 WebSocket URL
# 类型: string (url)
BINANCE_TESTNET_WS_URL=wss://stream.binancefuture.com

# API 请求超时（毫秒）
# 类型: int
BINANCE_API_TIMEOUT_MS=5000

# API 重试次数
# 类型: int
BINANCE_API_RETRY=3

# 是否启用代理
# 类型: bool
BINANCE_USE_PROXY=false

# 代理地址（启用代理时必填）
# 类型: string (url)
BINANCE_PROXY_URL=

# ==============================================================================
# 【3】交易对配置
# ==============================================================================

# 交易对（逗号分隔）
# 类型: list
TRADING_SYMBOLS=BTCUSDT,ETHUSDT

# 主周期
# 类型: string
PRIMARY_TIMEFRAME=3m

# 辅助周期
# 类型: string
AUX_TIMEFRAME=5m

# 合约类型: PERPETUAL | CURRENT_QUARTER | NEXT_QUARTER
# 类型: string
CONTRACT_TYPE=PERPETUAL

# ==============================================================================
# 【4】数据库配置
# ==============================================================================

# 数据库类型: postgres | timescale | sqlite
# 类型: string
DB_TYPE=timescale

# 数据库主机
# 类型: string
DB_HOST=localhost

# 数据库端口
# 类型: int
DB_PORT=5432

# 数据库名称
# 类型: string
DB_NAME=quant

# 数据库用户
# 类型: string
DB_USER=quant

# 数据库密码（含特殊字符用引号包裹）
# 类型: string (secret)
# 示例: DB_PASSWORD="p@ss#word"
DB_PASSWORD=change_me_in_production

# 数据库连接池大小
# 类型: int
DB_POOL_SIZE=10

# 数据库连接超时（秒）
# 类型: int
DB_CONNECT_TIMEOUT=10

# 是否启用 SSL
# 类型: bool
DB_SSL=false

# TimescaleDB 数据保留天数
# 类型: int
DB_RETENTION_DAYS=90

# ==============================================================================
# 【5】Redis 配置
# ==============================================================================

# Redis 主机
# 类型: string
REDIS_HOST=localhost

# Redis 端口
# 类型: int
REDIS_PORT=6379

# Redis 密码（无密码留空）
# 类型: string (secret)
REDIS_PASSWORD=

# Redis 数据库编号
# 类型: int
REDIS_DB=0

# Redis 连接池大小
# 类型: int
REDIS_POOL_SIZE=20

# Redis 连接超时（秒）
# 类型: int
REDIS_TIMEOUT=5

# ==============================================================================
# 【6】消息队列配置
# ==============================================================================

# 消息队列类型: redis_streams | kafka
# 类型: string
MQ_TYPE=redis_streams

# Kafka 配置
# 类型: string
KAFKA_BROKERS=localhost:9092

# Kafka 消费组
# 类型: string
KAFKA_GROUP_ID=quant-group

# Kafka offset 重置策略: latest | earliest
# 类型: string
KAFKA_AUTO_OFFSET_RESET=latest

# Redis Streams 最大长度
# 类型: int
MQ_STREAM_MAXLEN=100000

# 消费者组
# 类型: string
MQ_CONSUMER_GROUP=quant

# 消费者名称
# 类型: string
MQ_CONSUMER_NAME=consumer-1

# ==============================================================================
# 【7】执行模式
# ==============================================================================

# 执行模式: VIRTUAL | LIVE
# VIRTUAL: 虚拟券商（真实行情，虚拟结算）
# LIVE: 实盘交易
# 类型: string
EXECUTION_MODE=VIRTUAL

# 虚拟券商初始余额（USDT）
# 类型: float
VIRTUAL_INITIAL_BALANCE=1000

# 是否允许切换到实盘（安全开关）
# 类型: bool
ALLOW_LIVE_TRADING=false

# 实盘确认短语（切换到实盘时需输入）
# 类型: string
LIVE_CONFIRMATION_PHRASE=I_UNDERSTAND_THE_RISK

# ==============================================================================
# 【8】风险控制
# ==============================================================================

# 单笔最大风险（占账户权益百分比，0.02 = 2%）
# 类型: float
MAX_RISK_PER_TRADE=0.02

# 反向单风险
# 类型: float
MAX_RISK_PER_REVERSE=0.012

# 每日最大亏损
# 类型: float
MAX_DAILY_LOSS=0.05

# 最大回撤（触发降仓）
# 类型: float
MAX_DRAWDOWN=0.15

# 最大杠杆
# 类型: int
MAX_LEVERAGE=5

# 最大持仓量（张）
# 类型: int
MAX_POSITION_SIZE=1000

# 最大同时持仓数
# 类型: int
MAX_CONCURRENT_POSITIONS=3

# 组合最大风险（多品种）
# 类型: float
MAX_PORTFOLIO_RISK=0.03

# 单笔最小盈亏比（低于此值拒绝下单）
# 类型: float
MIN_RISK_REWARD_RATIO=1.5

# 订单频率限制（每分钟）
# 类型: int
ORDER_RATE_LIMIT=10

# ==============================================================================
# 【9】策略参数
# ==============================================================================

# 趋势均线周期
# 类型: int
STRATEGY_EMA_PERIOD=26

# 快速均线周期
# 类型: int
STRATEGY_EMA_FAST=12

# 带宽系数
# 类型: float
STRATEGY_BAND_K=1.0

# 进场阈值
# 类型: int
STRATEGY_ENTRY_THRESHOLD=60

# 反向阈值
# 类型: int
STRATEGY_REVERSE_THRESHOLD=80

# 止损 ATR 倍数
# 类型: float
STRATEGY_STOP_ATR=1.5

# 止盈盈亏比
# 类型: float
STRATEGY_TARGET_R=2.0

# 逃顶距离（ATR 倍数）
# 类型: float
STRATEGY_ESCAPE_ATR=4.0

# 时间止损（K 线数）
# 类型: int
STRATEGY_TIME_STOP_BARS=6

# 冷却期（K 线数）
# 类型: int
STRATEGY_COOLDOWN_BARS=3

# 加仓比例（倒金字塔，逗号分隔）
# 类型: list
STRATEGY_ADD_SCALES=1.0,0.8,0.4

# ==============================================================================
# 【10】AI 配置
# ==============================================================================

# 是否启用 AI
# 类型: bool
AI_ENABLED=true

# AI 模型路径
# 类型: string
AI_MODEL_PATH=./models

# AI 置信度阈值
# 类型: float
AI_CONFIDENCE_THRESHOLD=0.55

# AI 推理超时（毫秒）
# 类型: int
AI_INFERENCE_TIMEOUT_MS=200

# 是否启用 AI 自动调参
# 类型: bool
AI_AUTO_ADJUST=false

# 模型版本
# 类型: string
AI_MODEL_VERSION=v1.3

# GPU 设备（-1 表示 CPU）
# 类型: int
AI_GPU_DEVICE=-1

# ==============================================================================
# 【11】故障检测与自愈
# ==============================================================================

# 是否启用故障检测
# 类型: bool
FAULT_DETECTION_ENABLED=true

# 是否启用自动修复
# 类型: bool
AUTO_HEALING_ENABLED=true

# 自动修复频率限制（每小时最多）
# 类型: int
AUTO_HEALING_MAX_PER_HOUR=3

# 是否启用 AI 故障诊断
# 类型: bool
AI_DIAGNOSE_ENABLED=true

# 告警通知渠道（逗号分隔）: telegram,email,webhook
# 类型: list
ALERT_CHANNELS=telegram

# ==============================================================================
# 【12】监控与告警
# ==============================================================================

# Prometheus 端口
# 类型: int
PROMETHEUS_PORT=9090

# Grafana 端口
# 类型: int
GRAFANA_PORT=3001

# Grafana 管理员密码
# 类型: string (secret)
GRAFANA_ADMIN_PASSWORD=change_me

# 监控指标采样间隔（秒）
# 类型: int
METRICS_INTERVAL=5

# 健康检查间隔（秒）
# 类型: int
HEALTHCHECK_INTERVAL=30

# 告警阈值
# 类型: float
ALERT_CPU_THRESHOLD=0.85
ALERT_MEMORY_THRESHOLD=0.85
ALERT_DISK_THRESHOLD=0.90
ALERT_LATENCY_P99_MS=500

# ==============================================================================
# 【13】通知配置
# ==============================================================================

# Telegram
# 类型: bool
TELEGRAM_ENABLED=false

# 类型: string (secret)
TELEGRAM_BOT_TOKEN=

# 类型: string
TELEGRAM_CHAT_ID=

# 邮件
# 类型: bool
EMAIL_ENABLED=false

# 类型: string
EMAIL_SMTP_HOST=smtp.example.com

# 类型: int
EMAIL_SMTP_PORT=587

# 类型: string
EMAIL_SMTP_USER=

# 类型: string (secret)
EMAIL_SMTP_PASSWORD=

# 类型: string
EMAIL_FROM=noreply@example.com

# 类型: string
EMAIL_TO=admin@example.com

# Webhook
# 类型: bool
WEBHOOK_ENABLED=false

# 类型: string (url)
WEBHOOK_URL=

# ==============================================================================
# 【14】后端服务
# ==============================================================================

# 后端 HTTP 端口
# 类型: int
BACKEND_PORT=8000

# 后端绑定地址（0.0.0.0 允许外部访问）
# 类型: string
BACKEND_HOST=0.0.0.0

# Bootstrap 服务端口
# 类型: int
BOOTSTRAP_PORT=8080

# CORS 允许来源（逗号分隔）
# 类型: list
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT 密钥（生成方式: openssl rand -hex 32）
# 类型: string (secret)
JWT_SECRET=change_me_use_openssl_rand_hex_32

# JWT 过期时间（秒）
# 类型: int
JWT_EXPIRE_SECONDS=86400

# ==============================================================================
# 【15】前端配置
# ==============================================================================

# 前端 API 基础 URL
# 类型: string (url)
VITE_API_BASE_URL=http://localhost:8000

# 前端 WebSocket URL
# 类型: string (url)
VITE_WS_URL=ws://localhost:8000/ws

# 前端版本
# 类型: string
VITE_APP_VERSION=1.0.0

# 前端主题: light | dark
# 类型: string
VITE_THEME=light

# ==============================================================================
# 【16】性能优化
# ==============================================================================

# 线程池大小
# 类型: int
THREAD_POOL_SIZE=8

# 是否启用 SIMD 优化
# 类型: bool
ENABLE_SIMD=true

# 是否启用 CPU 亲和性绑定
# 类型: bool
ENABLE_CPU_AFFINITY=false

# 是否启用内存池
# 类型: bool
ENABLE_MEMORY_POOL=true

# 是否启用无锁队列
# 类型: bool
ENABLE_LOCKFREE_QUEUE=true

# 编译优化级别
# 类型: string
BUILD_OPTIMIZATION=O3

# ==============================================================================
# 【17】数据采集
# ==============================================================================

# K 线数据保留数量（内存）
# 类型: int
CANDLE_BUFFER_SIZE=1000

# 插针过滤 MAD 阈值
# 类型: int
SPIKE_FILTER_MAD=10

# 低流动性过滤阈值
# 类型: float
LOW_LIQUIDITY_THRESHOLD=0.2

# WebSocket 重连间隔（秒）
# 类型: int
WS_RECONNECT_INTERVAL=5

# WebSocket 最大重连次数
# 类型: int
WS_MAX_RECONNECT=10

# 数据缺口自动补齐
# 类型: bool
DATA_GAP_FILLER_ENABLED=true

# ==============================================================================
# 【18】备份与恢复
# ==============================================================================

# 备份目录
# 类型: string
BACKUP_DIR=./backups

# 自动备份间隔（小时）
# 类型: int
BACKUP_INTERVAL_HOURS=24

# 备份保留天数
# 类型: int
BACKUP_RETENTION_DAYS=30

# S3 备份
# 类型: bool
S3_BACKUP_ENABLED=false

# 类型: string
S3_BUCKET=

# 类型: string
S3_REGION=

# 类型: string (secret)
S3_ACCESS_KEY=

# 类型: string (secret)
S3_SECRET_KEY=

# ==============================================================================
# 【19】安全配置
# ==============================================================================

# 是否启用 API 限流
# 类型: bool
RATE_LIMIT_ENABLED=true

# 每 IP 每分钟最大请求数
# 类型: int
RATE_LIMIT_PER_IP=100

# 是否启用审计日志
# 类型: bool
AUDIT_LOG_ENABLED=true

# 审计日志保留天数
# 类型: int
AUDIT_LOG_RETENTION_DAYS=365

# IP 白名单
# 类型: bool
IP_WHITELIST_ENABLED=false

# IP 白名单（逗号分隔）
# 类型: list
IP_WHITELIST=

# ==============================================================================
# 【20】调试与开发
# ==============================================================================

# 是否启用性能分析
# 类型: bool
PROFILING_ENABLED=false

# 是否启用内存检查
# 类型: bool
MEMORY_CHECK_ENABLED=false

# 是否启用模拟模式
# 类型: bool
SIMULATION_MODE=false

# ==============================================================================
# 【21】Docker 配置
# ==============================================================================

# Docker 镜像前缀
# 类型: string
DOCKER_IMAGE_PREFIX=quant

# Docker 网络名称
# 类型: string
DOCKER_NETWORK=quant-net

# 容器时区
# 类型: string
DOCKER_TZ=UTC

# 容器内存限制
# 类型: string
DOCKER_MEMORY_LIMIT=8g

# 容器 CPU 限制
# 类型: float
DOCKER_CPU_LIMIT=4

# ==============================================================================
# 【22】合规与审计
# ==============================================================================

# 是否启用合规检查
# 类型: bool
COMPLIANCE_ENABLED=true

# 是否记录所有交易到审计日志
# 类型: bool
AUDIT_ALL_TRADES=true

# 是否记录所有参数变更
# 类型: bool
AUDIT_PARAM_CHANGES=true

# 是否需要双人审批高风险操作
# 类型: bool
DUAL_APPROVAL_REQUIRED=true

# ==============================================================================
# 首次部署检查清单
# ==============================================================================
#
# [ ] 1. cp .env.example .env
# [ ] 2. chmod 600 .env
# [ ] 3. 填入 BINANCE_API_KEY 和 BINANCE_API_SECRET
# [ ] 4. 修改 DB_PASSWORD 和 REDIS_PASSWORD
# [ ] 5. 生成 JWT_SECRET: openssl rand -hex 32
# [ ] 6. 修改 GRAFANA_ADMIN_PASSWORD
# [ ] 7. 确认 ENV=prod（生产环境）
# [ ] 8. 确认 DEBUG=false（生产环境）
# [ ] 9. 确认 BINANCE_TESTNET=false（生产环境）
# [ ] 10. 确认 EXECUTION_MODE=VIRTUAL（首次部署建议先虚拟）
# [ ] 11. 运行 python scripts/check_env.py 验证
#
# ==============================================================================
