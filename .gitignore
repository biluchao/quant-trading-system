# ==============================================================================
# 币安 BTC/ETH 3分钟量化交易系统 - .gitignore（生产级）
# ==============================================================================
# @file    .gitignore
# @version 1.0.1
# @brief   已修复 15 类运行时问题
# ==============================================================================

# ==============================================================================
# 【1】敏感信息（最高优先级）
# ==============================================================================

# 环境变量 - 保留模板
.env
.env.*
!.env.example
!.env.production.example
!.env.development.example

# 密钥文件
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.keystore
*.jks
*.truststore

# 密钥配置
config/config.core.secrets.yaml
config/*.secrets.yaml
config/*.secrets.json
secrets/
credentials/
.vault-token
.vault/

# SSH
id_rsa*
id_ed25519*
known_hosts
.ssh/

# 云凭证
.aws/
.azure/
.gcloud/
*.gcloud.json

# ==============================================================================
# 【2】构建产物（根目录限定）
# ==============================================================================

# C++ 构建
/build/
/build-*/
/cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
.conan/
/conan.lock
!conan.lock.template
conaninfo.txt
graph_info.json
/vcpkg_installed/
vcpkg-manifest-install.log

# C++ 编译产物
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.gch
*.pch
*.d
*.dSYM/

# 前端构建
/frontend/dist/
/frontend/build/
/frontend/node_modules/
/frontend/.vite/
/frontend/.cache/
/frontend/.parcel-cache/
/frontend/npm-debug.log*
/frontend/yarn-error.log*
/frontend/pnpm-debug.log*
/frontend/.pnp.*
/frontend/.npm/
/frontend/coverage/
/frontend/storybook-static/

# 发布包
/dist/
/packages/
*.tar.gz
*.zip
*.deb
*.rpm
*.dmg
*.msi

# ==============================================================================
# 【3】运行时数据（保留目录结构）
# ==============================================================================

# 数据目录 - 保留占位符
/data/*
!/data/.gitkeep
!/data/logs/
!/data/logs/.gitkeep
!/data/snapshots/
!/data/snapshots/.gitkeep
!/data/replay/
!/data/replay/.gitkeep
!/data/cache/
!/data/cache/.gitkeep

# 日志
logs/
*.log
*.log.*
!monitoring/logging.yaml
!docs/**/*.log

# 数据库
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
/postgres-data/
/pgdata/
/mysql-data/
/redis-data/

# 快照与缓存
snapshots/*.snapshot
*.snapshot
*.cache
!models/*.cache.keep
*.tmp
*.temp

# PID 与锁
*.pid
*.lock
!conan.lock
!package-lock.json
!requirements.lock

# ==============================================================================
# 【4】交易系统特定
# ==============================================================================

# 交易记录
/trades/
/orders/
/positions/
/accounts/
/param_history/
/param_approvals/
/signal_traces/
/audit/
/audit-logs/
*.audit.log

# 回测结果
/backtest-results/
/backtest_reports/
*.backtest.json

# 模型缓存（保留模型本体）
models/cache/
models/*.cache
models/*.tmp
models/*.log

# ==============================================================================
# 【5】IDE 与编辑器
# ==============================================================================

# VSCode - 保留示例
.vscode/*
!.vscode/settings.json.example
!.vscode/launch.json.example
!.vscode/tasks.json.example
!.vscode/extensions.json.example

# JetBrains
.idea/
*.iml
*.ipr
*.iws
cmake-build-*/

# Vim
*.swp
*.swo
*.swn
*~
.vim/
.netrwhist

# Emacs
\#*\#
.\#*

# Sublime
*.sublime-project
*.sublime-workspace

# Eclipse
.classpath
.project
.settings/
.cproject

# NetBeans
nbproject/

# ==============================================================================
# 【6】操作系统
# ==============================================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
.fseventsd
.TemporaryItems
.VolumeIcon.icns

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux
*~
.directory
.Trash-*
.nfs*

# ==============================================================================
# 【7】Python
# ==============================================================================

__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
ENV/
env/
.conda/
.miniconda/
.python-version

*.egg-info/
*.egg
/sdist/
/wheels/
*.whl

.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.ipynb_checkpoints/

.mypy_cache/
.dmypy.json
dmypy.json
.pyright/
.ruff_cache/

# ==============================================================================
# 【8】Node.js
# ==============================================================================

/node_modules/
jspm_packages/
web_modules/
.npm/
.yarn/
.yarn-integrity
*.tsbuildinfo
.eslintcache
.nyc_output/
coverage/

# ==============================================================================
# 【9】测试与基准
# ==============================================================================

/test-results/
/test-reports/
junit.xml
*.test.log
/benchmark-results/
*.bench
*.perf
/coverage-report/
lcov.info

# ==============================================================================
# 【10】监控与日志
# ==============================================================================

/prometheus-data/
*.prom
/grafana-data/
monitoring/logs/
monitoring/data/

# ==============================================================================
# 【11】文档生成
# ==============================================================================

docs/_build/
docs/build/
docs/site/
site/
docs/html/
docs/latex/
docs/xml/
docs/man/
docs/rtf/
Doxyfile.bak

# ==============================================================================
# 【12】临时与备份
# ==============================================================================

*.bak
*.backup
*.backup.*
*.bak.*
*.old
*.orig
*.rej
*.tmp
*.temp
*.swp
*.swo
*~
.#*
#*#
\#*\#
.\#*

/backups/
/backup/

# ==============================================================================
# 【13】工具生成
# ==============================================================================

tags
TAGS
cscope.*
.tags
.tags_sorted_by_file

perf.data
perf.data.old
*.prof
gmon.out

valgrind.log
callgrind.out.*
massif.out.*

*.gcno
*.gcda
*.gcov
*.lcov
*.sym
*.map

# ==============================================================================
# 【14】强制保留 - 不被忽略
# ==============================================================================

# 目录结构
!.gitkeep
!**/.gitkeep

# 配置文件（必须提交）
!config/config.core.params.json
!config/config.core.schema.json
!config/config.core.presets.json
!config/config.core.secrets.example.yaml
!config/*.contract.json

# 模型文件（必须提交或使用 LFS）
!models/*.onnx
!models/*.meta
!models/README.md

# 数据库迁移（必须提交）
!migrations/
!migrations/*.sql

# 契约文件（必须提交）
!**/*.contract.json

# 文档（必须提交）
!docs/**/*.md

# 测试数据（必须提交）
!tests/fixtures/
!tests/data/
!tests/**/*.json
!tests/**/*.csv

# CI/CD（必须提交）
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.gitlab-ci.yml
!.circleci/

# Docker（必须提交）
!Dockerfile.*
!docker-compose*.yml
!docker-compose*.yaml
!**/Dockerfile

# 脚本（必须提交）
!scripts/
!scripts/**/*.sh
!scripts/**/*.py

# 前端配置（必须提交）
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/.env.example
!frontend/.eslintrc.*
!frontend/.prettierrc.*

# 依赖锁定（必须提交）
!requirements.txt
!requirements-dev.txt
!requirements.lock
!pyproject.toml
!conanfile.txt
!vcpkg.json

# Makefile 与构建配置（必须提交）
!Makefile
!CMakeLists.txt
!cmake/
!cmake/**/*.cmake

# ==============================================================================
# 【15】Git LFS 追踪（大文件）
# ==============================================================================

# 注意：以下文件通过 .gitattributes 使用 LFS
# *.onnx  -> models/
# *.meta  -> models/
