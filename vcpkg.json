{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "quant-trading-system",
  "version-semver": "1.0.0",
  "description": "Binance BTC/ETH 3-minute quantitative trading system",
  "homepage": "https://github.com/your-org/quant-trading-system",
  "license": "MIT",
  "builtin-baseline": "a42af01b72c28a8e1d7b48107b33e4f286a55ef6",
  "dependencies": [
    "boost-system",
    "boost-filesystem",
    "openssl",
    "spdlog",
    "nlohmann-json",
    "eigen3",
    "libpqxx",
    "hiredis"
  ],
  "overrides": [
    {
      "name": "openssl",
      "version": "3.2.1"
    },
    {
      "name": "spdlog",
      "version": "1.14.1"
    },
    {
      "name": "nlohmann-json",
      "version": "3.11.3"
    },
    {
      "name": "eigen3",
      "version": "3.4.0"
    }
  ],
  "features": {
    "ai": {
      "description": "Enable AI inference with ONNX Runtime (CPU)",
      "dependencies": [
        "onnxruntime"
      ]
    },
    "ai-gpu": {
      "description": "Enable AI inference with ONNX Runtime (GPU, Windows only)",
      "dependencies": [
        {
          "name": "onnxruntime-gpu",
          "platform": "windows"
        }
      ]
    },
    "redis-plus-plus": {
      "description": "Enable C++ Redis client (built on hiredis)",
      "dependencies": [
        "redis-plus-plus"
      ]
    },
    "tests": {
      "description": "Build unit tests with GTest",
      "dependencies": [
        "gtest"
      ]
    },
    "benchmarks": {
      "description": "Build benchmarks with Google Benchmark",
      "dependencies": [
        "benchmark"
      ]
    },
    "tools": {
      "description": "Build deployment and diagnostic tools",
      "dependencies": []
    }
  },
  "default-features": [
    "tests",
    "benchmarks",
    "tools"
  ]
}
