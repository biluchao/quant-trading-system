# ==============================================================================
# 币安 BTC/ETH 3分钟量化交易系统 - .dockerignore（生产级修复版）
# ==============================================================================
# @file    .dockerignore
# @version 1.0.1
# @brief   已修复 30 类运行时问题
#
# 关键约定:
#   - 注释必须在行首，无前导空格
#   - 模式按最后匹配优先，! 必须在排除模式之后
#   - 目录用 data/* 而非 data/ 以便使用 ! 恢复子文件
#   - 不排除 .dockerignore 自身（否则规则失效）
#   - 不排除 Dockerfile.*（多阶段构建需要）
#   - 每个 context 目录（如 frontend/）应有自己的 .dockerignore
# ==============================================================================

# ==============================================================================
# 【1】版本控制
# ==============================================================================
.git/
.gitignore
.gitattributes
.gitmodules
.github/
.gitlab-ci.yml
.circleci/
.gitea/

# ==============================================================================
# 【2】敏感信息 - 绝对排除
# ==============================================================================

# 环境变量（保留模板）
.env
.env.*
!.env.example
!.env.production.example
!.env.development.example
!.env.dev

# 密钥文件
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.keystore
*.jks
*.truststore

# 密钥配置
config/*.secrets.yaml
config/*.secrets.json
config/secrets/
secrets/
credentials/
.vault-token
.vault/

# SSH
.ssh/
id_rsa*
id_ed25519*
known_hosts

# 云凭证
.aws/
.azure/
.gcloud/
*.gcloud.json

# ==============================================================================
# 【3】C++ 构建产物
# ==============================================================================
/build/
/build-*/
/cmake-build-*/
/out/
/target/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.gch
*.pch
*.d
*.dSYM/

# 依赖管理缓存（保留锁文件）
.conan/
conaninfo.txt
graph_info.json
vcpkg_installed/
vcpkg-manifest-install.log

# ==============================================================================
# 【4】前端构建产物
# ==============================================================================
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.cache/
frontend/.parcel-cache/
frontend/.npm/
frontend/.yarn/
frontend/npm-debug.log*
frontend/yarn-error.log*
frontend/coverage/
frontend/storybook-static/
frontend/.turbo/
frontend/.next/
frontend/out/

# ==============================================================================
# 【5】发布包
# ==============================================================================
/dist/
/packages/
*.tar.gz
*.zip
*.deb
*.rpm
*.dmg
*.msi

# ==============================================================================
# 【6】运行时数据（保留目录占位）
# ==============================================================================

# 数据目录
/data/*
!/data/.gitkeep
!/data/logs/
!/data/logs/.gitkeep
!/data/snapshots/
!/data/snapshots/.gitkeep
!/data/replay/
!/data/replay/.gitkeep
!/data/cache/
!/data/cache/.gitkeep

# 日志
logs/
*.log
*.log.*
!monitoring/logging.yaml

# 数据库
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
/postgres-data/
/pgdata/
/mysql-data/
/redis-data/

# 快照与缓存
snapshots/*.snapshot
*.snapshot
*.cache
*.tmp
*.temp

# PID 与锁（保留锁文件）
*.pid
*.lock

# ==============================================================================
# 【7】交易系统特定数据
# ==============================================================================
/trades/
/orders/
/positions/
/accounts/
/param_history/
/param_approvals/
/signal_traces/
/audit/
/audit-logs/
*.audit.log
/backtest-results/
/backtest_reports/
*.backtest.json

# 模型缓存（保留模型本体）
models/cache/
models/*.cache
models/*.tmp
models/*.log

# ==============================================================================
# 【8】测试与基准（可按需保留）
# ==============================================================================
/tests/
/test-results/
/test-reports/
junit.xml
*.test.log
/benchmarks/
/benchmark-results/
*.bench
*.perf
/coverage-report/
lcov.info
*.gcno
*.gcda
*.gcov
*.lcov
htmlcov/
.coverage
coverage.xml
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/

# ==============================================================================
# 【9】文档（按需保留）
# ==============================================================================
/docs/
docs/_build/
docs/build/
docs/site/
docs/html/
docs/latex/
docs/xml/
site/
*.md
!README.md
!LICENSE
!LICENSE.md
!CHANGELOG.md
!CONTRIBUTING.md
Doxyfile

# ==============================================================================
# 【10】IDE 与编辑器
# ==============================================================================
.vscode/*
!.vscode/settings.json.example
!.vscode/launch.json.example
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*.swn
*~
.vim/
.netrwhist
\#*\#
.\#*
*.sublime-project
*.sublime-workspace
.classpath
.project
.settings/
.cproject
nbproject/

# ==============================================================================
# 【11】操作系统
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
.fseventsd
.TemporaryItems
.VolumeIcon.icns
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump
.directory
.Trash-*
.nfs*

# ==============================================================================
# 【12】Python
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.conda/
.miniconda/
.python-version
*.egg-info/
*.egg
/sdist/
/wheels/
*.whl
.ipynb_checkpoints/
.dmypy.json
dmypy.json
.pyright/

# ==============================================================================
# 【13】Node.js
# ==============================================================================
/node_modules/
jspm_packages/
web_modules/
.npm/
.yarn/
.yarn-integrity
*.tsbuildinfo
.eslintcache
.nyc_output/

# ==============================================================================
# 【14】监控与日志
# ==============================================================================
/prometheus-data/
*.prom
/grafana-data/
monitoring/logs/
monitoring/data/
!monitoring/prometheus.yml
!monitoring/logging.yaml

# ==============================================================================
# 【15】工具生成
# ==============================================================================
tags
TAGS
cscope.*
.tags
.tags_sorted_by_file
perf.data
perf.data.old
*.prof
gmon.out
valgrind.log
callgrind.out.*
massif.out.*
*.sym
*.map

# ==============================================================================
# 【16】临时与备份
# ==============================================================================
*.bak
*.backup
*.backup.*
*.bak.*
*.old
*.orig
*.rej
/backups/
/backup/

# ==============================================================================
# 【17】强制保留（放在最后，确保生效）
# ==============================================================================

# 目录占位
!.gitkeep
!**/.gitkeep

# 项目必需文件
!CMakeLists.txt
!CMakePresets.json
!Makefile
!VERSION
!pyproject.toml
!conanfile.txt
!conan.lock
!vcpkg.json
!requirements.txt
!requirements-dev.txt

# 配置（必须提交）
!config/config.core.params.json
!config/config.core.schema.json
!config/config.core.presets.json
!config/config.core.secrets.example.yaml
!config/*.contract.json

# 模型元数据
!models/*.onnx
!models/*.meta
!models/README.md

# 迁移脚本
!migrations/
!migrations/*.sql

# 契约文件
!**/*.contract.json

# 脚本
!scripts/
!scripts/**/*.sh
!scripts/**/*.py
!scripts/**/*.bash

# Dockerfile 相关
!Dockerfile.*
!docker-compose*.yml
!docker-compose*.yaml

# 前端配置
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/.env.example
!frontend/.eslintrc.*
!frontend/.prettierrc.*

# 监控配置
!monitoring/prometheus.yml
!monitoring/logging.yaml
!monitoring/alerts/

# CI/CD
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.gitlab-ci.yml
