# ==============================================================================
# 币安 BTC/ETH 3分钟量化交易系统 - .dockerignore（生产级）
# ==============================================================================
# @file    .dockerignore
# @version 1.0.1
# @brief   已修复 15 类运行时问题
# ==============================================================================

# ==============================================================================
# 【1】敏感信息 - 绝对排除
# ==============================================================================

# 环境变量（保留模板）
.env
.env.*
!.env.example
!.env.production.example
!.env.development.example

# 密钥文件
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.keystore
*.jks
*.truststore

# 密钥配置
config/config.core.secrets.yaml
config/*.secrets.yaml
config/*.secrets.json
secrets/
credentials/
.vault-token
.vault/

# SSH
.ssh/
id_rsa*
id_ed25519*
known_hosts

# 云凭证
.aws/
.azure/
.gcloud/
*.gcloud.json

# ==============================================================================
# 【2】版本控制
# ==============================================================================

# 排除大部分 .git，但保留 HEAD 和 refs（用于版本号）
.git/*
!.git/HEAD
!.git/refs/
!.git/refs/heads/
!.git/refs/tags/

.gitignore
.gitattributes
.gitmodules

# CI/CD 配置（不需要在镜像内）
.github/
.gitlab-ci.yml
.circleci/
.gitea/

# ==============================================================================
# 【3】构建产物
# ==============================================================================

# C++ 构建
/build/
/build-*/
/cmake-build-*/
/out/
/target/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# C++ 编译产物
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.gch
*.pch
*.d
*.dSYM/

# 依赖管理（保留锁定）
.conan/
conaninfo.txt
graph_info.json
vcpkg_installed/
vcpkg-manifest-install.log
# 保留 conan.lock

# 前端构建
/frontend/node_modules/
/frontend/dist/
/frontend/build/
/frontend/.vite/
/frontend/.cache/
/frontend/.parcel-cache/
/frontend/.npm/
/frontend/.yarn/
/frontend/npm-debug.log*
/frontend/yarn-error.log*
/frontend/coverage/
/frontend/storybook-static/

# 发布包
/dist/
/packages/
*.tar.gz
*.zip
*.deb
*.rpm
*.dmg
*.msi

# ==============================================================================
# 【4】运行时数据
# ==============================================================================

# 数据目录（保留占位符）
data/*
!data/.gitkeep

# 日志
logs/
*.log
*.log.*
!monitoring/logging.yaml

# 数据库
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
/postgres-data/
/pgdata/
/mysql-data/
/redis-data/

# 快照与缓存
snapshots/
*.snapshot
*.cache
!models/*.cache.keep
*.tmp
*.temp

# PID 与锁
*.pid
*.lock

# ==============================================================================
# 【5】IDE 与编辑器
# ==============================================================================

.vscode/
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*.swn
*~
.vim/
.netrwhist
\#*\#
.\#*
*.sublime-project
*.sublime-workspace
.classpath
.project
.settings/
.cproject
nbproject/

# ==============================================================================
# 【6】操作系统
# ==============================================================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
.fseventsd
.TemporaryItems
.VolumeIcon.icns
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump
.directory
.Trash-*
.nfs*

# ==============================================================================
# 【7】Python
# ==============================================================================

__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.conda/
.miniconda/
.python-version
*.egg-info/
*.egg
/sdist/
/wheels/
*.whl
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.ipynb_checkpoints/
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/
.ruff_cache/

# ==============================================================================
# 【8】Node.js
# ==============================================================================

/node_modules/
jspm_packages/
web_modules/
.npm/
.yarn/
.yarn-integrity
*.tsbuildinfo
.eslintcache
.nyc_output/
coverage/

# ==============================================================================
# 【9】测试与基准
# ==============================================================================

# 默认排除测试（CI 镜像可用单独 .dockerignore.ci）
/tests/
/test-results/
/test-reports/
junit.xml
*.test.log
/benchmarks/
/benchmark-results/
*.bench
*.perf
/coverage-report/
lcov.info
*.gcno
*.gcda
*.gcov
*.lcov

# ==============================================================================
# 【10】文档
# ==============================================================================

/docs/
*.md
!README.md
!LICENSE
!LICENSE.md
!CHANGELOG.md
!CONTRIBUTING.md
Doxyfile
docs/html/
docs/latex/
docs/xml/

# ==============================================================================
# 【11】监控与日志
# ==============================================================================

/prometheus-data/
*.prom
/grafana-data/
monitoring/logs/
monitoring/data/

# ==============================================================================
# 【12】交易系统特定
# ==============================================================================

/trades/
/orders/
/positions/
/accounts/
/param_history/
/param_approvals/
/signal_traces/
/audit/
/audit-logs/
*.audit.log
/backtest-results/
/backtest_reports/
*.backtest.json

# 模型缓存（保留模型本体）
models/cache/
models/*.cache
models/*.tmp
models/*.log
# 保留 .onnx 和 .meta

# ==============================================================================
# 【13】工具生成
# ==============================================================================

tags
TAGS
cscope.*
.tags
.tags_sorted_by_file
perf.data
perf.data.old
*.prof
gmon.out
valgrind.log
callgrind.out.*
massif.out.*

# ==============================================================================
# 【14】临时与备份
# ==============================================================================

*.bak
*.backup
*.backup.*
*.bak.*
*.old
*.orig
*.rej
/backups/
/backup/

# ==============================================================================
# 【15】Docker 自身
# ==============================================================================

Dockerfile*
docker-compose*.yml
docker-compose*.yaml
.dockerignore
.dockerignore.*
.docker/
